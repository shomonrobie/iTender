# fix_and_restart.ps1 - Ultra-safe ASCII-only version
# Save with UTF-8 encoding (no BOM) in VS Code or Notepad

$ErrorActionPreference = 'Continue'
$ProjectRoot = "D:\TenderAI.com.bd\v2\TenderAI"
$ComposeFile = "$ProjectRoot\docker-compose.yml"

Write-Host "Fixing TenderAI build issues..." -ForegroundColor Cyan

# 1. Fix frontend Dockerfile: add missing Tailwind plugins
$DockerfilePath = "$ProjectRoot\frontend\Dockerfile"
$content = Get-Content $DockerfilePath -Raw -Encoding UTF8

# Check if the fix is already applied
if ($content -notlike "*@tailwindcss/forms*") {
    # Insert npm install line before "RUN npm run build"
    $oldLine = "RUN npm run build"
    $newLines = "RUN npm install -D @tailwindcss/forms @tailwindcss/typography`r`n$oldLine"
    $fixed = $content -replace [regex]::Escape($oldLine), $newLines
    
    # Write back with UTF-8 encoding (no BOM)
    $utf8NoBom = New-Object System.Text.UTF8Encoding $false
    [System.IO.File]::WriteAllText($DockerfilePath, $fixed, $utf8NoBom)
    Write-Host "[OK] Added Tailwind plugins to frontend/Dockerfile" -ForegroundColor Green
} else {
    Write-Host "[OK] Tailwind plugins already present in Dockerfile" -ForegroundColor Green
}

# 2. Refresh PATH for npm (simple concatenation)
$MachinePath = [Environment]::GetEnvironmentVariable("Path", "Machine")
$UserPath = [Environment]::GetEnvironmentVariable("Path", "User")
$NewPath = $MachinePath + ";" + $UserPath
$env:Path = $NewPath

# 3. Rebuild frontend with no cache
Write-Host ""
Write-Host "Rebuilding frontend..." -ForegroundColor Cyan
docker-compose --file $ComposeFile --project-directory $ProjectRoot build frontend --no-cache

# 4. Restart stack
Write-Host ""
Write-Host "Restarting TenderAI..." -ForegroundColor Cyan
docker-compose --file $ComposeFile --project-directory $ProjectRoot up -d

# 5. Wait and test
Write-Host ""
Write-Host "Waiting 90 seconds..." -ForegroundColor DarkGray
Start-Sleep -Seconds 90

# Check container status
Write-Host ""
Write-Host "Container status:" -ForegroundColor Cyan
docker-compose --file $ComposeFile --project-directory $ProjectRoot ps

# Test endpoints
Write-Host ""
Write-Host "Testing endpoints:" -ForegroundColor Cyan

# Backend health
$BackendOK = $false
try {
    $resp = Invoke-WebRequest -Uri "http://localhost:8000/health" -TimeoutSec 5 -ErrorAction Stop
    if ($resp.StatusCode -eq 200) {
        Write-Host "  [OK] Backend: http://localhost:8000" -ForegroundColor Green
        $BackendOK = $true
    }
} catch {
    Write-Host "  [WAIT] Backend starting..." -ForegroundColor Yellow
}

# Frontend health
$FrontendOK = $false
try {
    $resp = Invoke-WebRequest -Uri "http://localhost:3000" -TimeoutSec 5 -ErrorAction Stop
    if ($resp.StatusCode -eq 200) {
        Write-Host "  [OK] Frontend: http://localhost:3000" -ForegroundColor Green
        $FrontendOK = $true
    }
} catch {
    Write-Host "  [WAIT] Frontend building (Next.js can take 2-5 mins)..." -ForegroundColor Yellow
}

# Final summary
Write-Host ""
Write-Host "======================================================================"
if ($BackendOK -and $FrontendOK) {
    Write-Host "SUCCESS! TenderAI is running." -ForegroundColor Green
    Write-Host "Open: http://localhost:3000" -ForegroundColor Cyan
} else {
    Write-Host "Services still starting. Check logs:" -ForegroundColor Yellow
    Write-Host "  docker-compose --file $ComposeFile logs -f frontend"
}